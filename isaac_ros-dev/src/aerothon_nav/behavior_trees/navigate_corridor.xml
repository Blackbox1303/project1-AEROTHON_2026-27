<!--
  Corridor navigation: replan at 2 Hz (obstacles appear as the D435 sees them), follow with
  the MPPI controller (omnidirectional). On failure only wait - no spin / back-up between corridor walls, and NO
  costmap clearing either: at the return corridor's mouth a 'Failed to make progress' cleared both costmaps, the
  mapped walls were gone and MPPI drifted the drone into the wall end (2026-10-20 sim). corridor_nav re-sends the goal
  every second, which restarts the tree.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="4" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="2.0">
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
            <Wait wait_duration="1"/>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="FollowPath"/>
          <Wait wait_duration="1"/>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <Wait wait_duration="2"/>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
