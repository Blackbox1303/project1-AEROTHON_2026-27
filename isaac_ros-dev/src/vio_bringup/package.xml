  <version>0.1.0</version>
  <description>Bring-up for D435 + Pixhawk (PX4) IMU VIO with Isaac ROS cuVSLAM</description>
  <maintainer email="f20230424@hyderabad.bits-pilani.ac.in">szyfrowac</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
