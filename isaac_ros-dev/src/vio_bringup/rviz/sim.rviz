    - Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 0.5
      Name: Drone body (base_link)
      Radius: 0.029999999329447746
      Reference Frame: base_link
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
