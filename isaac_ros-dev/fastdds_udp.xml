<?xml version="1.0" encoding="UTF-8" ?>
<!--
  FastDDS: UDP only, no shared memory. Used inside the container (scripts/start_container.sh sets
  FASTRTPS_DEFAULT_PROFILES_FILE). Host processes run as the normal user and container processes as
  root, so shared-memory segments created by one side are not writable by the other and data stops
  arriving (discovery still works, so topics are listed but stay silent). Participants using this
  profile advertise only UDP, so their peers reach them over UDP; the host needs no change.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <transport_descriptors>
        <transport_descriptor>
            <transport_id>udp_only</transport_id>
            <type>UDPv4</type>
        </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="udp_only_participant" is_default_profile="true">
        <rtps>
            <userTransports>
                <transport_id>udp_only</transport_id>
            </userTransports>
            <useBuiltinTransports>false</useBuiltinTransports>
        </rtps>
    </participant>
</profiles>
