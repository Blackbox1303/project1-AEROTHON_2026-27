#!/bin/bash
# AeroTHON ground apps - ONE launcher that switches between them (one app at a time: starting one stops the other).
#   aerothon onboard  [aruco|qr] [radio]                      THE FINAL MISSION: dashboard on the ground SiK radio
#   aerothon offboard [aruco|qr] [drop|nodrop] [radio] [video] [target]
#                                                             this laptop = the offboard ground station (VRX + SiK)
#   aerothon sim      [aruco|qr]                              TESTING by Ethernet: the Jetson's full dashboard
#                                                             (Sim / Offboard Jetson / Real / Open Gazebo)
#   aerothon fieldtest cable [jetson-ip] | radio [radio]      FIELD TEST, props OFF: the Jetson's cameras / detectors /
#                                                             walk-through guidance + motor cues (http://127.0.0.1:8096)
#   aerothon stop | status | log | switcher                   switcher = the one-page app switcher, http://127.0.0.1:8079
# Defaults: aruco, drop, radio /dev/ttyUSB0:57600, video '' (pick on the page), target '' (read the start board).
# A busy port (8080 / 8094): our own earlier app (this workspace, an older ~/aerothon_radio_gcs, the old radio GCS) is
# closed first; anything else holding it is named and left alone (--force closes it too, never a system service).
HERE=$(dirname "$(readlink -f "$0")")
RUN=${XDG_RUNTIME_DIR:-/tmp}/aerothon-$USER; mkdir -p "$RUN"
LOGDIR=$HOME/.cache/aerothon; mkdir -p "$LOGDIR"
JETSON_IP=${JETSON_IP:-10.42.0.247}
FORCE=0; ARGS=()
for a in "$@"; do [ "$a" = --force ] && FORCE=1 || ARGS+=("$a"); done
set -- "${ARGS[@]}"

say() { echo "[aerothon] $*"; }

pyenv() {
    PYV=$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])')
    [ -d "$HERE/pylib/py$PYV" ] || { say "run $HERE/install.sh first (no packages for Python $PYV yet)"; exit 1; }
    export PYTHONPATH="$HERE/pylib/py$PYV${PYTHONPATH:+:$PYTHONPATH}"
}

ours() {   # ours <pid>: one of our ground apps (any copy), run by this user
    local cmd; cmd=$(tr '\0' ' ' < /proc/$1/cmdline 2>/dev/null) || return 1
    [ "$(stat -c %U /proc/$1 2>/dev/null)" = "$USER" ] || return 1
    # only the ground-app COPIES (this workspace, the earlier ~/aerothon_radio_gcs bundle, the old installs) - never the
    # Jetson dashboard's own vrx_explore / gcs_server under ~/workspaces (a running offboard stack there)
    case "$cmd" in *"$HERE"/*|*aerothon_radio_gcs/*|*.local/share/aerothon_gcs/*|*.local/share/vrx_delivery/*|*radio_gcs.py*) ;; *) return 1 ;; esac
    case "$cmd" in *gcs_server.py*|*vrx_explore.py*|*laptop_vrx_mission.py*|*radio_gcs.py*|*field_ground.py*) return 0 ;; esac
    return 1
}

service() {   # the systemd service a pid runs in (the last *.service of its cgroup path), '' for a plain program
    tr '/' '\n' < /proc/$1/cgroup 2>/dev/null | grep -E '\.service$' | grep -vE '^(user@[0-9]+|init|gnome-terminal-server)\.service$' | tail -1
}

holders() { ss -ltnpH "sport = :$1" 2>/dev/null | grep -oE 'pid=[0-9]+' | cut -d= -f2 | sort -u; }

stop_pid() {
    kill "$1" 2>/dev/null
    for _ in $(seq 30); do kill -0 "$1" 2>/dev/null || return 0; sleep 0.1; done
    kill -9 "$1" 2>/dev/null; sleep 0.3
}

stop_ours() {   # the app this launcher started, then any of ours still running
    if [ -f "$RUN/app.pid" ]; then
        local p; p=$(cat "$RUN/app.pid")
        if kill -0 "$p" 2>/dev/null && ours "$p"; then say "closing $(cat "$RUN/app.name" 2>/dev/null) (pid $p)"; stop_pid "$p"; fi
        rm -f "$RUN/app.pid" "$RUN/app.name" "$RUN/app.url"
    fi
    for p in $(pgrep -u "$USER" -f 'gcs_server.py|vrx_explore.py|laptop_vrx_mission.py|radio_gcs.py|field_ground.py'); do
        [ "$p" = "$$" ] && continue
        ours "$p" && { say "closing an earlier app (pid $p)"; stop_pid "$p"; }
    done
}

free_port() {   # free_port <port>: ok when free; ours are closed; a foreign holder is named (--force: closed)
    local p svc
    for p in $(holders "$1"); do
        if ours "$p"; then say "port $1 busy with our earlier app (pid $p): closing it"; stop_pid "$p"; continue; fi
        svc=$(service "$p")
        say "port $1 is held by pid $p: $(tr '\0' ' ' < /proc/$p/cmdline 2>/dev/null | cut -c1-100)${svc:+ (service $svc)}"
        if [ -n "$svc" ]; then say "a system service - not closing it. Stop it yourself:  systemctl --user stop $svc"; return 1; fi
        if [ "$FORCE" = 1 ]; then say "--force: closing it"; stop_pid "$p"; else say "not ours - add --force to close it"; return 1; fi
    done
    systemctl --user stop radio-gcs 2>/dev/null   # the old 8081 Radio GCS holds the SiK radio
    return 0
}

launch() {   # launch <name> <url> <cmd...>: in the background, logged, remembered
    local name=$1 url=$2; shift 2
    local log="$LOGDIR/$name.log"
    setsid "$@" > "$log" 2>&1 < /dev/null &
    local p=$!
    echo "$p" > "$RUN/app.pid"; echo "$name" > "$RUN/app.name"; echo "$url" > "$RUN/app.url"
    for _ in $(seq 40); do
        kill -0 "$p" 2>/dev/null || { say "$name exited - its log:"; tail -n 15 "$log"; rm -f "$RUN/app.pid"; return 1; }
        curl -s -m 1 -o /dev/null "$url/" && break
        sleep 0.5
    done
    say "$name running (pid $p): $url   log: $log"
    [ -n "$NO_BROWSER" ] || (xdg-open "$url" >/dev/null 2>&1 &)
}

# the ground SiK radio: the port given if it is there, else the one radio plugged in - SiK / FTDI / CP210x by its USB
# id, else the only ttyUSB* / ttyACM* (a SiK shows as either). Prints DEV:BAUD (the given one if none found).
find_radio() {
    local dev=${1%%:*} baud=${1##*:} c
    [ "$baud" = "$1" ] && baud=57600
    if [ ! -e "$dev" ]; then
        c=$(ls /dev/serial/by-id/ 2>/dev/null | grep -iE 'sik|3dr|rfd|radio|telem|ftdi|ft231|silicon_labs|cp210' \
            | grep -viE 'ardupilot|pixhawk|px4|cube' | head -1)
        if [ -n "$c" ]; then c=$(readlink -f "/dev/serial/by-id/$c")
        else c=$(ls /dev/ttyUSB* /dev/ttyACM* 2>/dev/null); [ "$(echo "$c" | grep -c .)" = 1 ] || c=""; fi
        [ -n "$c" ] && dev=$c
    fi
    echo "$dev:$baud"
}
radio_check() { [ -e "${1%%:*}" ] || say "WARNING: ${1%%:*} not found - plug the ground radio in (ls /dev/ttyUSB* /dev/ttyACM* /dev/serial/by-id/)"; }

case "${1:-}" in
  onboard)
    M=${2:-aruco}; DEV=$(find_radio "${3:-/dev/ttyUSB0:57600}")
    pyenv; stop_ours; free_port 8080 || exit 1; radio_check "$DEV"
    say "onboard ($M boards): the dashboard on the radio $DEV - QGC: SiK auto-connect OFF, UDP 14550 ON"
    launch "onboard-$M" http://127.0.0.1:8080 python3 -s "$HERE/apps/dashboard/gcs_server.py" --radio "$DEV" --port 8080 --marker "$M" ;;
  offboard)
    M=${2:-aruco}; DROP=${3:-drop}; DEV=$(find_radio "${4:-/dev/ttyUSB0:57600}"); VIDEO=${5:-}; TARGET=${6:-}
    ALT=1.0; [ "$M" = qr ] && ALT=10.0
    A=(--link "$DEV" --alt "$ALT" --marker "$M" --qgc 127.0.0.1:14550 --port 8094)
    [ "$DROP" = drop ] && A+=(--drop); [ -n "$VIDEO" ] && A+=(--video "$VIDEO"); [ -n "$TARGET" ] && A+=(--start-qr "$TARGET")
    [ -d "$HERE/apps/offboard/wechat_qrcode" ] && A+=(--wechat-dir "$HERE/apps/offboard/wechat_qrcode")
    pyenv; stop_ours; free_port 8094 || exit 1; radio_check "$DEV"
    say "offboard ($M boards, $DROP, search at $ALT m) on $DEV - set the ZONE on the page before Start"
    launch "offboard-$M" http://127.0.0.1:8094 python3 -s "$HERE/apps/offboard/src/gcs/vrx_explore/vrx_explore.py" "${A[@]}" ;;
  sim)
    M=${2:-aruco}; PORT=8084; [ "$M" = qr ] && PORT=8080
    stop_ours
    URL=http://$JETSON_IP:$PORT
    if curl -s -m 3 -o /dev/null "$URL/"; then
        echo "sim-$M" > "$RUN/app.name"; echo "$URL" > "$RUN/app.url"; rm -f "$RUN/app.pid"
        say "the Jetson's $M dashboard: $URL (Sim / Offboard Jetson / Real / Open Gazebo; its Stop stops the stack)"
        [ -n "$NO_BROWSER" ] || (xdg-open "$URL" >/dev/null 2>&1 &)
    elif ping -c 1 -W 2 "$JETSON_IP" >/dev/null 2>&1; then
        say "the Jetson answers but its $PORT dashboard is down - on the Jetson:"
        [ "$PORT" = 8084 ] && say "  ~/workspaces/isaac_ros-dev/src/launch_all/scripts/gcs_aruco.sh start" \
                           || say "  systemctl --user restart gcs-dashboard"; exit 1
    else
        say "no link to the Jetson ($JETSON_IP): sim testing needs an Ethernet cable. The final mission does not (aerothon onboard)."
        exit 1
    fi ;;
  fieldtest)
    L=${2:-cable}
    pyenv; stop_ours; free_port 8096 || exit 1
    if [ "$L" = radio ]; then
        DEV=$(find_radio "${3:-/dev/ttyUSB0:57600}"); radio_check "$DEV"
        say "field test over the radio $DEV (no video) - QGC: SiK auto-connect OFF, UDP 14550 ON. PROPS OFF."
        launch fieldtest-radio http://127.0.0.1:8096 python3 -s "$HERE/apps/fieldtest/field_ground.py" --radio "$DEV"
    else
        IP=${3:-$JETSON_IP}
        ping -c 1 -W 2 "$IP" >/dev/null 2>&1 || say "WARNING: no answer from the Jetson ($IP): Ethernet cable?"
        say "field test by cable, Jetson $IP (press Start on the page). PROPS OFF."
        launch fieldtest-cable http://127.0.0.1:8096 python3 -s "$HERE/apps/fieldtest/field_ground.py" --jetson "http://$IP:8097"
    fi ;;
  stop)
    stop_ours; rm -f "$RUN/app.name" "$RUN/app.url"; say "stopped" ;;
  status)
    if [ -f "$RUN/app.pid" ] && kill -0 "$(cat "$RUN/app.pid")" 2>/dev/null; then
        say "running: $(cat "$RUN/app.name") (pid $(cat "$RUN/app.pid")) $(cat "$RUN/app.url")"
    elif [ -f "$RUN/app.name" ]; then say "$(cat "$RUN/app.name"): $(cat "$RUN/app.url") (on the Jetson)"
    else say "no app running"; fi
    for port in 8080 8094 8096 8079; do for p in $(holders $port); do say "  port $port: pid $p $(tr '\0' ' ' < /proc/$p/cmdline 2>/dev/null | cut -c1-80)"; done; done ;;
  log)
    n=$(cat "$RUN/app.name" 2>/dev/null); [ -n "$n" ] && [ -f "$LOGDIR/$n.log" ] && tail -n 40 -f "$LOGDIR/$n.log" || say "no app log" ;;
  switcher)
    pyenv
    # always a fresh one: a switcher left running from an older install kept showing its old page (no field test)
    for p in $( { holders 8079; pgrep -u "$USER" -f '[s]witcher.py'; } | sort -u); do
        case "$( { tr '\0' ' ' < /proc/$p/cmdline; } 2>/dev/null)" in python3*switcher.py*) stop_pid "$p" ;; esac
    done
    setsid python3 -s "$HERE/switcher.py" > "$LOGDIR/switcher.log" 2>&1 < /dev/null &
    for _ in $(seq 20); do curl -s -m 1 -o /dev/null http://127.0.0.1:8079/ && break; sleep 0.3; done
    curl -s -m 1 -o /dev/null http://127.0.0.1:8079/ || { say "switcher did not start:"; tail -n 5 "$LOGDIR/switcher.log"; exit 1; }
    say "switcher: http://127.0.0.1:8079"
    [ -n "$NO_BROWSER" ] || (xdg-open http://127.0.0.1:8079 >/dev/null 2>&1 &) ;;
  *)
    sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//' ; exit 1 ;;
esac
